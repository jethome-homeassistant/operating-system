# Board options present in the vendor kernel's own arch/arm64/configs/
# jethub_j310_defconfig but lost when kernel-j310.config was captured.
# Listed last in BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES so they win.
#
# Everything here is built in (=y) on purpose: this board ships no
# modules-load.d, and jethub-initer runs with DefaultDependencies=no before
# /mnt is available, so anything left as a module would never be loaded.
# Armbian marks some of these =m in config/kernel/linux-jethub-j310-vendor.config
# because it has udev and modules-load to fall back on; we do not.
#
# Room to do this: the built Image squashfs-compresses to 13.1 MiB against the
# 24 MiB KERNEL_SIZE slot in scripts/hdd-image.sh.

# In-tree Realtek driver (drivers/net/wireless/realtek/rtl8821CU). Use this
# rather than BR2_PACKAGE_RTL8821CU: the out-of-tree package gates on
# LINUX_VERSION_CODE, which reports 5.15 while this tree carries a cfg80211
# backported from ~6.7, so it fails to build. Armbian skips that same
# out-of-tree driver for j310 (KERNEL_DRIVERS_SKIP+=(driver_rtl8811CU_rtl8821C)).
CONFIG_RTL8821CU=y

# On-board peripherals
CONFIG_RTC_DRV_PCF8563=y
CONFIG_SENSORS_TMP102=y

# 1-Wire: master over I2C (DS2482) and over GPIO, plus the DS18B20 thermometer
CONFIG_W1_MASTER_DS2482=y
CONFIG_W1_MASTER_GPIO=y
CONFIG_W1_SLAVE_THERM=y

# The vendor defconfig and Armbian both use a 48-bit VA space; the merged
# config would otherwise fall back to the 39-bit default of this choice.
# CONFIG_ARM64_VA_BITS_39 is not set
CONFIG_ARM64_VA_BITS_48=y

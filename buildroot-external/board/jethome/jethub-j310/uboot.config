CONFIG_FS_SQUASHFS=y
CONFIG_CMD_SQUASHFS=y
CONFIG_LZO=y
CONFIG_CMD_PART=y
CONFIG_CMD_IMPORTENV=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_FDT=y
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_CMD_BOOTI=y
CONFIG_HUSH_PARSER=y
CONFIG_DISPLAY_BOARDINFO=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_UUIDS=y
CONFIG_PARTITION_TYPE_GUID=y
CONFIG_DOS_PARTITION=y
CONFIG_SUPPORT_EMMC_BOOT=y
CONFIG_BOOTDELAY=-2
CONFIG_BOOTCOMMAND="setenv devtype mmc; setenv devnum 1; if part number mmc 1 hassos-boot bootpart && load mmc 1:${bootpart} 0x12000000 boot.scr; then source 0x12000000; else echo Normal boot failed, trying recovery...; run boot_recovery; fi"

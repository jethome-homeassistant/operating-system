# U-Boot configuration fragment for JetHome JetHub D3-mini (j310).
#
# Base defconfig: jethub_j310 from github.com/jethome-iot/u-boot (Amlogic
# 2023.01 vendor tree, branch jethub_j310).  That tree is NOT mainline U-Boot:
# board/amlogic/configs/jethub_j310.h does not pull in configs/meson64.h, and
# the shared HAOS fragment (buildroot-external/bootloader/uboot.config) is not
# safe to apply on top of it (see the notes at the bottom of this file).
# Everything HAOS needs is therefore listed explicitly here.

# --- mandatory: HAOS keeps the kernel in a SquashFS image ---------------------
# genimage/images-os.cfg builds kernel.img as SquashFS with LZO compression and
# the boot script reads it with the generic "load" command.  The vendor
# defconfig has FS_SQUASHFS, CMD_SQUASHFS and LZO all disabled, so without
# these three the A/B slot kernel can never be loaded.
CONFIG_FS_SQUASHFS=y
CONFIG_CMD_SQUASHFS=y
CONFIG_LZO=y

# --- partitioning -------------------------------------------------------------
# HAOS uses PARTITION_TABLE_TYPE=mbr (see meta), so DOS partitions are required.
CONFIG_DOS_PARTITION=y

# --- commands used by uboot-boot.ush ------------------------------------------
# part start ...            -> CMD_PART
# env import / env export   -> CMD_IMPORTENV / CMD_EXPORTENV
# setexpr ...               -> CMD_SETEXPR
# load / fatload ...        -> CMD_FS_GENERIC / CMD_FAT / FS_FAT
# fdt addr|resize|apply ... -> CMD_FDT / OF_LIBFDT_OVERLAY
# booti ...                 -> CMD_BOOTI
# These are already enabled by configs/jethub_j310_defconfig; they are repeated
# here so that a future change to the vendor defconfig cannot silently make the
# board unbootable.
CONFIG_CMD_PART=y
CONFIG_CMD_IMPORTENV=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_FDT=y
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_CMD_BOOTI=y
CONFIG_HUSH_PARSER=y

# --- fileenv ------------------------------------------------------------------
# `fileenv <interface> <dev:part> <addr> <file> <envvar>` is a HAOS-local U-Boot
# command.  It does not exist in the pristine vendor tree, but it IS added to
# this exact U-Boot pin by
#   buildroot-external/patches/uboot/e7b621dc7d821d56dc6be216e061bb9a59ce4283/
#     0001-CMD-read-string-from-fileinto-env.patch
# which Buildroot applies automatically (BR2_GLOBAL_PATCH_DIR points at
# buildroot-external/patches and the directory name matches
# BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION).  Enabling it makes cmdline.txt on the
# hassos-boot partition authoritative, exactly like on the other HAOS boards,
# and avoids an "Unknown command 'fileenv'" message on every boot.
# cmd/fileenv.c calls do_fat_fsload(), so CONFIG_CMD_FAT=y above is required.
CONFIG_CMD_FILEENV=y

# --- cosmetic -----------------------------------------------------------------
CONFIG_DISPLAY_BOARDINFO=y

# --- deliberately NOT set -----------------------------------------------------
# CONFIG_ENV_IS_NOWHERE
#     The vendor defconfig stores the U-Boot environment in eMMC
#     (CONFIG_ENV_IS_IN_MMC=y, CONFIG_SYS_MMC_ENV_DEV=1, CONFIG_SYS_MMC_ENV_PART=0,
#     CONFIG_ENV_OFFSET=0x380000, CONFIG_ENV_SIZE=0x10000).  Enabling the
#     "nowhere" driver on top of that is unnecessary and would risk changing
#     which environment U-Boot loads at boot.
# CONFIG_EFI_PARTITION
#     board/amlogic/configs/jethub_j310.h already #defines it; leave the Kconfig
#     symbol alone to avoid fighting the board header.
# CONFIG_BOOTDELAY
#     Left at the vendor value of 5 for hardware bring-up.  Tighten to -2 (the
#     value the other HAOS boards use) once the board boots reliably.

# HAOS base kernel options for the vendor Amlogic 5.15 tree
# (jethome-iot/linux-kernel, branch linux-s7-5.15, 5.15.153).
#
# This is the 5.15 equivalent of kernel/v6.18.y/haos.config. Every symbol
# below has been verified to exist in the vendor 5.15 Kconfig (including
# common_drivers/). Symbols that only exist in 6.x were dropped or replaced
# by their 5.15 counterpart; the replacements are called out inline.

CONFIG_LOCALVERSION="-haos"
CONFIG_EXPERT=y

# GCC plugins are disabled by linux.mk, disable them here to reduce
# linux-diff-config noise
CONFIG_GCC_PLUGINS=n

# The vendor defconfig builds with -Werror using the Amlogic/Android GCC.
# Buildroot uses a much newer GCC which emits warnings the vendor tree was
# never built against, so -Werror has to go.
# CONFIG_WERROR is not set

CONFIG_CMDLINE=""
CONFIG_PANIC_TIMEOUT=5

CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_DEBUG_PREEMPT is not set

CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# 6.18 uses "# CONFIG_MODULE_COMPRESS is not set"; 5.15 models this as a
# choice, so the equivalent is MODULE_COMPRESS_NONE.
CONFIG_MODULE_COMPRESS_NONE=y

# 5.15 firmware compression is XZ-only (FW_LOADER_COMPRESS_ZSTD does not
# exist yet). BR2_PACKAGE_LINUX_FIRMWARE_COMPRESS_ZSTD must stay off.
CONFIG_FW_LOADER_COMPRESS=y

# ZRAM_BACKEND_LZ4 does not exist in 5.15 - the default compressor is picked
# through the ZRAM_DEF_COMP choice instead. ZSMALLOC is m in the vendor
# defconfig and has to be y for a built-in ZRAM.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
# ZSWAP depends on (does not select) FRONTSWAP in 5.15.
CONFIG_FRONTSWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y

# Multi-generational LRU is backported into this vendor tree.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

CONFIG_CPU_FREQ_GOV_ONDEMAND=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y

CONFIG_MISC_FILESYSTEMS=y
CONFIG_BLOCK=y

# EROFS: the rootfs is EROFS, so all of this must be built in. Note the
# vendor 5.15 tree caps EROFS_ALL_FEATURE_INCOMPAT at 0x0f, which is why
# mkfs.erofs must not be run with -Ededupe/-Efragments/ztailpacking.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y

CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_VERITY=y

# systemd requirements that the vendor (Android-derived) defconfig misses.
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_UEVENT_HELPER is not set

CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# AppArmor is a hard requirement of the HA Supervisor. In 5.15 the active
# LSMs are selected by the CONFIG_LSM string; DEFAULT_SECURITY_APPARMOR only
# picks the default ordering, so CONFIG_LSM is set explicitly as well.
CONFIG_AUDIT=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_DAC is not set
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="apparmor"

CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_MICHAEL_MIC=y

CONFIG_CRYPTO_USER=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_RNG=m
CONFIG_CRYPTO_USER_API_AEAD=m

CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# CONFIG_LOGO is not set
# CONFIG_DEBUG_STACK_USAGE is not set

CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_LE=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_LEDS=y

CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
# IPV6_REACHABILITY_PROBE is not an upstream 5.15 symbol; it is created by
# buildroot-external/patches/linux/7cdd51ba613e0d0be8f47e3778eb747bd220af73/
# 0001-ipv6-add-option-to-explicitly-enable-reachability-te.patch, which
# Buildroot applies to this pinned vendor tree. Keep it in sync with
# kernel/v6.18.y/haos.config.
CONFIG_IPV6_REACHABILITY_PROBE=y
CONFIG_IPV6_SIT=m

CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_MROUTE=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_MROUTE=y

CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y

# NF_TPROXY_IPV4/IPV6, NETFILTER_NETLINK_QUEUE, NETFILTER_XT_MARK and
# NETFILTER_XT_TARGET_NETMAP are built-in (=y) instead of =m as in the 6.18
# fragment: the vendor base config already selects them from built-in users,
# so =m would silently be promoted to =y anyway.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NF_FLOW_TABLE=m

CONFIG_NFT_NUMGEN=m
CONFIG_NFT_CT=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_XFRM=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NFT_REJECT_IPV4=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_REJECT_IPV6=m
CONFIG_NFT_DUP_IPV6=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_BRIDGE_META=m
CONFIG_NFT_BRIDGE_REJECT=m

CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_NETMAP=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m

CONFIG_IP_SET=m
CONFIG_IP_SET_BITMAP_IP=m
CONFIG_IP_SET_BITMAP_IPMAC=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPMARK=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_IPMAC=m
CONFIG_IP_SET_HASH_MAC=m
CONFIG_IP_SET_HASH_NETPORTNET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETNET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_IP_VS=m
CONFIG_IP_VS_IPV6=y

CONFIG_TUN=y
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y
CONFIG_VLAN_8021Q_MVRP=y

CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=m

CONFIG_WIRELESS=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y

# The vendor defconfig has NFS_FS off entirely, so it has to be turned on
# here before the NFSv4 options can take effect.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y

CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
# CIFS_POSIX depends on CIFS_ALLOW_INSECURE_LEGACY in 5.15.
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_DFS_UPCALL=y

CONFIG_WIREGUARD=m

CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_HID_MULTITOUCH=m

CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

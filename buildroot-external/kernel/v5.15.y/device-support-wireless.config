# WiFi drivers for the vendor Amlogic 5.15 tree.
#
# 5.15 equivalent of kernel/v6.18.y/device-support-wireless.config, restricted
# to USB devices. Differences from the 6.18 fragment:
#   - No SDIO WiFi drivers. The JetHub D3-mini has no SDIO WiFi; WiFi and
#     Zigbee are on USB. ATH10K_SDIO / ATH6KL_SDIO / MWIFIEX_SDIO / MT7663S /
#     RTL8723BS are therefore deliberately left out.
#   - rtw88 in this vendor tree only ships PCI front-ends (8822BE, 8822CE,
#     8723DE, 8821CE) - the SDIO/USB variants (RTW88_8822BU, RTW88_8822CU,
#     RTW88_8723DU, ...) do not exist in 5.15, so the whole rtw88 block is
#     dropped from this USB-only fragment.
#   - RTW89 does not exist in 5.15 (added in 5.16) - dropped.
#   - MT7921U / MT7921S do not exist in 5.15 - dropped.
#
# USB WiFi dongles used on this board are served by the out-of-tree Buildroot
# packages rtl88x2bu and rtl8821cu.

# Atheros drivers
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=m
CONFIG_ATH10K_USB=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m

# Broadcom drivers
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_B43=m
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_N=y
CONFIG_B43_PHY_LP=y
CONFIG_B43_PHY_HT=y
CONFIG_BRCMSMAC=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y

# Intel drivers
# Note: enabling it here but Intel drivers are currently exclusively PCI
CONFIG_WLAN_VENDOR_INTEL=y

# Marvell drivers
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m

# Mediatek drivers
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT7663U=m
CONFIG_MT76x0E=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT76x2E=m

# Ralink drivers
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT2X00=m

# Realtek drivers
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8192CU=m
CONFIG_RTL_CARDS=m

# Staging tree stays enabled (the vendor tree keeps drivers there), but no
# staging WiFi driver is selected - RTL8723BS is SDIO-only.
CONFIG_STAGING=y

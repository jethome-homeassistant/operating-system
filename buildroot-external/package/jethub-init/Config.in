config BR2_PACKAGE_JETHUB_INIT
	bool "jethub-init"
	select BR2_PACKAGE_LIBGPIOD2
	select BR2_PACKAGE_LIBGPIOD2_TOOLS
	help
	  JetHub hardware init for HAOS: the board's jethub-init script
	  (GPIO / LED / zigbee / UXM setup), POSIX sh + libgpiod v2,
	  run by jethub-initer.service. Installed from the release
	  tarball, the same scripts the Armbian packages carry.

	  https://github.com/jethome-iot/jethub-init

if BR2_PACKAGE_JETHUB_INIT

config BR2_PACKAGE_JETHUB_INIT_BOARD
	string "JetHub board (j80 / j100 / j200 / j310)"
	help
	  Board folder in the tarball whose jethub-init is installed as
	  /usr/lib/jethome/jethub-init.

endif
